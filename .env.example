# Copy to .env (or export) to configure the cache. All optional.
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.5
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_STALE_AFTER_SECONDS=1800
SEMANTIC_CACHE_MAX_ENTRIES=10000
SEMANTIC_CACHE_MAX_BYTES=50000000
SEMANTIC_CACHE_EMBEDDING_DIM=256
SEMANTIC_CACHE_NAMESPACE=default
SEMANTIC_CACHE_STALE_POLICY=serve_stale_and_refresh
